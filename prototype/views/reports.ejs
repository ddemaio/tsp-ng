<%- include('partials/header', { user }) %>

<div class="page-header">
  <h1>Financial Reports</h1>
  <a href="/" class="btn btn-secondary">Back to Dashboard</a>
</div>

<div class="filter-box">
  <h3>Generate a report</h3>
  <form method="GET" action="/reports" class="filter-form">
    <div class="form-group">
      <label for="from">Event date from</label>
      <input type="date" name="from" id="from" value="<%= from %>" required>
    </div>
    <div class="form-group">
      <label for="to">Event date to</label>
      <input type="date" name="to" id="to" value="<%= to %>" required>
    </div>
    <div class="form-group">
      <label for="status">Status</label>
      <select name="status" id="status">
        <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>All statuses</option>
        <option value="cancelled" <%= statusFilter === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        <option value="rejected" <%= statusFilter === 'rejected' ? 'selected' : '' %>>Rejected</option>
        <option value="accepted" <%= statusFilter === 'accepted' ? 'selected' : '' %>>Accepted</option>
        <option value="submitted_for_payment" <%= statusFilter === 'submitted_for_payment' ? 'selected' : '' %>>Submitted for payment</option>
        <option value="paid" <%= statusFilter === 'paid' ? 'selected' : '' %>>Accepted &amp; paid</option>
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Generate Report</button>
    <% if (rows.length > 0) { %>
      <button type="submit" name="format" value="csv" class="btn btn-secondary">Download CSV</button>
    <% } %>
  </form>
</div>

<% if (from && to) { %>
  <div class="report-summary">
    <div class="summary-card">
      <span class="summary-label">Requests in range</span>
      <span class="summary-value"><%= totalCount %></span>
    </div>
    <div class="summary-card">
      <span class="summary-label">Total approved</span>
      <span class="summary-value">&euro; <%= totalApproved.toFixed(2) %></span>
    </div>
    <div class="summary-card">
      <span class="summary-label">Total paid</span>
      <span class="summary-value">&euro; <%= totalPaid.toFixed(2) %></span>
    </div>
  </div>

  <% if (rows.length === 0) { %>
    <div class="empty-state"><p>No requests found for this date range and status.</p></div>
  <% } else { %>
    <table class="reports-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Event</th>
          <th>Event location</th>
          <th>Recipient</th>
          <th>Recipient country</th>
          <th>Status</th>
          <th>Approved</th>
          <th>Paid</th>
          <th>Method</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr>
            <td><%= r.event_start %> &ndash; <%= r.event_end %></td>
            <td><a href="/requests/<%= r.id %>"><%= r.event_name %></a></td>
            <td><%= r.event_location %></td>
            <td><%= r.requester_name %></td>
            <td><%= r.requester_country %></td>
            <td><span class="state-badge small <%= r.state %>"><%= r.state %></span></td>
            <td><%= r.approved_total ? r.approved_total.toFixed(2) + ' EUR' : '-' %></td>
            <td><%= r.paid_amount != null ? r.paid_amount.toFixed(2) + ' EUR' : '-' %></td>
            <td><%= r.payment_method || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
<% } else { %>
  <div class="empty-state"><p>Select a date range (event dates) and an optional status to build the report.</p></div>
<% } %>

<%- include('partials/footer') %>